# ============================================
# Mizan AI - Production Environment Variables
# ============================================

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=production
PORT=5000
APP_NAME=Mizan AI
APP_VERSION=1.0.0

# ============================================
# DATABASE CONFIGURATION
# ============================================
DATABASE_URL=postgresql://mizan:change_this_password_in_production@db.mizan.local:5432/mizan_db
DB_HOST=db.mizan.local
DB_PORT=5432
DB_USER=mizan
DB_PASSWORD=change_this_password_in_production
DB_NAME=mizan_db
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRE=8h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRE=30d

# ============================================
# REDIS CACHE
# ============================================
REDIS_URL=redis://redis.mizan.local:6379
REDIS_PASSWORD=change_this_password_in_production
REDIS_DB=0
REDIS_TTL=3600

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_API_URL=https://api.mizan.local/api
VITE_APP_URL=https://mizan.local
VITE_APP_NAME=Mizan AI

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_FILES=30
LOG_MAX_SIZE=10m
LOG_FORMAT=json

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@mizan.local
SMTP_FROM_NAME=Mizan AI

# ============================================
# AWS S3 BACKUP (Optional)
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=mizan-backups
AWS_S3_PREFIX=backups/

# ============================================
# SSL/TLS CERTIFICATES
# ============================================
SSL_KEY_PATH=./certs/server.key
SSL_CERT_PATH=./certs/server.crt
SSL_ENABLED=true

# ============================================
# SECURITY HEADERS
# ============================================
CORS_ORIGIN=https://mizan.local,https://app.mizan.local
CORS_CREDENTIALS=true
CSP_ENABLE=true
HEADERS_ENABLE=true

# ============================================
# MONITORING & ANALYTICS
# ============================================
APM_ENABLED=false
APM_SERVER_URL=https://apm.example.com
APM_SERVICE_NAME=mizan-ai
SENTRY_ENABLED=false
SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# ============================================
# BACKUP & DISASTER RECOVERY
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPT=true
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key-min-32-chars

# ============================================
# AUDIT & COMPLIANCE
# ============================================
AUDIT_ENABLED=true
AUDIT_LOG_DIR=./logs/audit
AUDIT_RETENTION_DAYS=90

# ============================================
# MAINTENANCE MODE
# ============================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System under maintenance. Please try again later.

# ============================================
# TIMEOUTS & PERFORMANCE
# ============================================
REQUEST_TIMEOUT=30000
SHUTDOWN_TIMEOUT=30000
GRACEFUL_SHUTDOWN=true

# ============================================
# ALLOWED DOMAINS
# ============================================
ALLOWED_DOMAINS=mizan.local,app.mizan.local,api.mizan.local
ALLOWED_HOSTS=mizan.local,*.mizan.local

# ============================================
# GEO-LOCATION (Optional)
# ============================================
GEO_ENABLED=false
GEO_API_KEY=your-geolocation-api-key

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_AI_ANALYSIS=true
FEATURE_ADVANCED_REPORTING=true
FEATURE_MULTI_CURRENCY=true
FEATURE_AUDIT_LOG=true
