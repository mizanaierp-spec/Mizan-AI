# Production Environment - STRICT SECURITY
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}
DB_HOST=postgres
DB_PORT=5432
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_NAME=${DB_NAME}

PORT=5000
NODE_ENV=production
LOG_LEVEL=warn
LOG_DIR=/app/logs

# JWT - Must be strong and unique per deployment
JWT_SECRET=${JWT_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_EXPIRE=8h
JWT_REFRESH_EXPIRE=7d
REFRESH_TOKEN_ROTATION=true

# Frontend Production URL
VITE_API_URL=https://api.mizan.local/api

# Rate Limiting - Stricter in production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=3
LOGIN_ATTEMPT_LIMIT=3
LOGIN_ATTEMPT_WINDOW=300000

# Redis Production
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=${REDIS_PASSWORD}

# 2FA Required for Platform Admin
TWOFA_ISSUER=Mizan AI Production
TWOFA_WINDOW=1
REQUIRE_2FA_FOR_PLATFORM_ADMIN=true

# Email - Production SMTP
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=587
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
SMTP_FROM=noreply@mizan.ai

# Payment Gateway
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}

# AI
AI_API_KEY=${AI_API_KEY}
AI_MODEL=gpt-4
AI_RATE_LIMIT=50
AI_RATE_WINDOW=3600

# Backup
BACKUP_RETENTION_DAYS=90
BACKUP_SCHEDULE=0 2 * * *
BACKUP_LOCATION=/backups
BACKUP_ENCRYPTION=true

# CORS - Restricted in production
CORS_ORIGIN=https://mizan.ai,https://www.mizan.ai
ALLOWED_HOSTS=mizan.ai,www.mizan.ai,api.mizan.ai

# Session
SESSION_TIMEOUT=3600000
REFRESH_TOKEN_FAMILY_SIZE=5
SESSION_STORE=redis

# Audit
AUDIT_LOG_RETENTION_DAYS=730
AUDIT_LOG_LEVEL=info

# Platform Admin Bootstrap - Must be changed immediately
PLATFORM_OWNER_EMAIL=${PLATFORM_OWNER_EMAIL}
PLATFORM_OWNER_PASSWORD=${PLATFORM_OWNER_PASSWORD}
PLATFORM_OWNER_NAME=${PLATFORM_OWNER_NAME}
FORCE_PASSWORD_CHANGE_ON_FIRST_LOGIN=true

# Cookies - Secure in production
SECURE_COOKIES=true
SAMESITE_COOKIES=Strict
HTTPS_ONLY=true

# Security Headers
HSTS_MAX_AGE=31536000
ENABLE_CSRF_PROTECTION=true
ENABLE_SECURITY_HEADERS=true
