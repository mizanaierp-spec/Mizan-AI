{
  "name": "mizan-ai",
  "version": "1.0.0",
  "description": "منظومة محاسبة ذكية متكاملة - Intelligent Accounting System",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "test": "jest --detectOpenHandles",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:scenario": "jest tests/scenarios",
    "test:coverage": "jest --coverage",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:reset": "node db/reset.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js"
  },
  "keywords": [
    "accounting",
    "erp",
    "finance",
    "ai",
    "محاسبة",
    "نظام"
  ],
  "author": "Mizan AI Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "pdfkit": "^0.13.0",
    "xlsx": "^0.18.5",
    "axios": "^1.6.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0"
  }
}
