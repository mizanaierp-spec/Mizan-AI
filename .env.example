# Application
NODE_ENV=development
PORT=3000
APP_NAME=Mizan AI
APP_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mizan_ai
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=8h

# AI/LLM
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@mizan-ai.com

# Backup
BACKUP_PATH=/backups
BACKUP_RETENTION_DAYS=30

# Security
BCRYPT_ROUNDS=10
RATES_LIMIT_WINDOW=15
RATES_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log
