# Database Configuration
DATABASE_URL=postgresql://mizan:mizan123@postgres:5432/mizan_db
DB_HOST=postgres
DB_PORT=5432
DB_USER=mizan
DB_PASSWORD=mizan123
DB_NAME=mizan_db

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
LOG_DIR=./logs

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_EXPIRE=8h
JWT_REFRESH_EXPIRE=7d
REFRESH_TOKEN_ROTATION=true

# Frontend
VITE_API_URL=http://localhost:5000/api

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5
LOGIN_ATTEMPT_LIMIT=5
LOGIN_ATTEMPT_WINDOW=900000

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# 2FA Configuration
TWOFA_ISSUER=Mizan AI
TWOFA_WINDOW=1

# Email Configuration (Optional for production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mizan.local

# Stripe/Payment Gateway (For future integration)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# AI Configuration
AI_API_KEY=
AI_MODEL=gpt-4
AI_RATE_LIMIT=100
AI_RATE_WINDOW=3600

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
BACKUP_LOCATION=/backups

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,mizan.local,api.mizan.local

# Session Configuration
SESSION_TIMEOUT=3600000
REFRESH_TOKEN_FAMILY_SIZE=5

# Audit
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_LEVEL=info

# Platform Admin Bootstrap (Change immediately after first login)
PLATFORM_OWNER_EMAIL=owner@mizan.local
PLATFORM_OWNER_PASSWORD=ChangeMe123!@#
PLATFORM_OWNER_NAME=Platform Owner

# Production Security
SECURE_COOKIES=false
SAMESITE_COOKIES=Lax
HTTPS_ONLY=false
